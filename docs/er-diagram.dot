digraph ER {

    graph [
        label       = "习题推荐系统 — 数据库 ER 图"
        labelloc    = t
        fontname    = "Microsoft YaHei"
        fontsize    = 18
        rankdir     = LR
        splines     = ortho
        nodesep     = 0.8
        ranksep     = 2.0
        bgcolor     = white
    ]
    node  [shape=none fontname="Microsoft YaHei" fontsize=11]
    edge  [fontname="Microsoft YaHei" fontsize=10 color="#555555"]

    // ─────────────────────────────────────────────────────────────
    // 实体定义（HTML 表格标签）
    // ─────────────────────────────────────────────────────────────

    sys_user [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#1565C0"><FONT COLOR="white"><B> sys_user （用户表）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#BBDEFB"><B>字段</B></TD><TD BGCOLOR="#BBDEFB"><B>类型</B></TD><TD BGCOLOR="#BBDEFB"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT">用户名 UNIQUE</TD></TR>
        <TR><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD ALIGN="LEFT">BCrypt密码</TD></TR>
        <TR><TD ALIGN="LEFT">nickname</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT">昵称</TD></TR>
        <TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT">邮箱</TD></TR>
        <TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT">STUDENT/TEACHER/ADMIN</TD></TR>
        <TR><TD ALIGN="LEFT">is_enabled</TD><TD ALIGN="LEFT">TINYINT</TD><TD ALIGN="LEFT">是否启用</TD></TR>
        <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">创建时间</TD></TR>
        </TABLE>
    >]

    course [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#1B5E20"><FONT COLOR="white"><B> course （课程表）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#C8E6C9"><B>字段</B></TD><TD BGCOLOR="#C8E6C9"><B>类型</B></TD><TD BGCOLOR="#C8E6C9"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT">课程名称</TD></TR>
        <TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT">课程简介</TD></TR>
        <TR><TD PORT="teacher_id" ALIGN="LEFT">🔗 teacher_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD ALIGN="LEFT">invite_code</TD><TD ALIGN="LEFT">VARCHAR(10)</TD><TD ALIGN="LEFT">邀请码 UNIQUE</TD></TR>
        <TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">TINYINT</TD><TD ALIGN="LEFT">是否启用</TD></TR>
        </TABLE>
    >]

    classroom [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#1B5E20"><FONT COLOR="white"><B> classroom （班级表）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#C8E6C9"><B>字段</B></TD><TD BGCOLOR="#C8E6C9"><B>类型</B></TD><TD BGCOLOR="#C8E6C9"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT">班级名称</TD></TR>
        <TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT">班级描述</TD></TR>
        <TR><TD PORT="teacher_id" ALIGN="LEFT">🔗 teacher_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD ALIGN="LEFT">invite_code</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT">加入邀请码 UNIQUE</TD></TR>
        <TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">TINYINT</TD><TD ALIGN="LEFT">是否启用</TD></TR>
        <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">创建时间</TD></TR>
        <TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">更新时间</TD></TR>
        </TABLE>
    >]

    classroom_course [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#37474F"><FONT COLOR="white"><B> classroom_course （班级-课程关联）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#ECEFF1"><B>字段</B></TD><TD BGCOLOR="#ECEFF1"><B>类型</B></TD><TD BGCOLOR="#ECEFF1"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD PORT="classroom_id" ALIGN="LEFT">🔗 classroom_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→classroom</TD></TR>
        <TR><TD PORT="course_id" ALIGN="LEFT">🔗 course_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→course</TD></TR>
        <TR><TD ALIGN="LEFT">added_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">添加时间</TD></TR>
        <TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE(classroom_id, course_id)</TD></TR>
        </TABLE>
    >]

    classroom_student [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#37474F"><FONT COLOR="white"><B> classroom_student （班级-学生关联）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#ECEFF1"><B>字段</B></TD><TD BGCOLOR="#ECEFF1"><B>类型</B></TD><TD BGCOLOR="#ECEFF1"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD PORT="classroom_id" ALIGN="LEFT">🔗 classroom_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→classroom</TD></TR>
        <TR><TD PORT="user_id" ALIGN="LEFT">🔗 user_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD ALIGN="LEFT">joined_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">加入时间</TD></TR>
        <TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE(classroom_id, user_id)</TD></TR>
        </TABLE>
    >]

    knowledge_point [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#4A148C"><FONT COLOR="white"><B> knowledge_point （知识点表）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#E1BEE7"><B>字段</B></TD><TD BGCOLOR="#E1BEE7"><B>类型</B></TD><TD BGCOLOR="#E1BEE7"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT">名称 kc0/可读名</TD></TR>
        <TR><TD PORT="course_id" ALIGN="LEFT">🔗 course_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→course</TD></TR>
        <TR><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">父知识点</TD></TR>
        <TR><TD ALIGN="LEFT">py_kc_index</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT">Python索引kc0~</TD></TR>
        </TABLE>
    >]

    exercise [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#E65100"><FONT COLOR="white"><B> exercise （习题表）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#FFE0B2"><B>字段</B></TD><TD BGCOLOR="#FFE0B2"><B>类型</B></TD><TD BGCOLOR="#FFE0B2"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT">LONGTEXT</TD><TD ALIGN="LEFT">题目正文(Markdown)</TD></TR>
        <TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT">题型</TD></TR>
        <TR><TD ALIGN="LEFT">answer_key</TD><TD ALIGN="LEFT">LONGTEXT</TD><TD ALIGN="LEFT">标准答案</TD></TR>
        <TR><TD ALIGN="LEFT">difficulty</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT">EASY/MEDIUM/HARD</TD></TR>
        <TR><TD PORT="course_id" ALIGN="LEFT">🔗 course_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→course</TD></TR>
        <TR><TD PORT="creator_id" ALIGN="LEFT">🔗 creator_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD ALIGN="LEFT">py_ex_index</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT">Python索引ex0~</TD></TR>
        </TABLE>
    >]

    exercise_kp_rel [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#37474F"><FONT COLOR="white"><B> exercise_kp_rel （习题-知识点关联）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#ECEFF1"><B>字段</B></TD><TD BGCOLOR="#ECEFF1"><B>类型</B></TD><TD BGCOLOR="#ECEFF1"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD PORT="exercise_id" ALIGN="LEFT">🔗 exercise_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→exercise</TD></TR>
        <TR><TD PORT="kp_id" ALIGN="LEFT">🔗 knowledge_point_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→knowledge_point</TD></TR>
        </TABLE>
    >]

    answer_record [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#AD1457"><FONT COLOR="white"><B> answer_record （答题记录表）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#FCE4EC"><B>字段</B></TD><TD BGCOLOR="#FCE4EC"><B>类型</B></TD><TD BGCOLOR="#FCE4EC"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD PORT="user_id" ALIGN="LEFT">🔗 user_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD PORT="exercise_id" ALIGN="LEFT">🔗 exercise_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→exercise</TD></TR>
        <TR><TD ALIGN="LEFT">answer</TD><TD ALIGN="LEFT">LONGTEXT</TD><TD ALIGN="LEFT">作答内容</TD></TR>
        <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT">SUBMITTED/GRADED/AUTO_GRADED</TD></TR>
        <TR><TD ALIGN="LEFT">score</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT">得分</TD></TR>
        <TR><TD ALIGN="LEFT">teacher_comment</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT">教师评语</TD></TR>
        <TR><TD PORT="graded_by" ALIGN="LEFT">🔗 graded_by</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD ALIGN="LEFT">submitted_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">提交时间</TD></TR>
        </TABLE>
    >]

    recommendation_record [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#00695C"><FONT COLOR="white"><B> recommendation_record （推荐记录）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#E0F2F1"><B>字段</B></TD><TD BGCOLOR="#E0F2F1"><B>类型</B></TD><TD BGCOLOR="#E0F2F1"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD PORT="user_id" ALIGN="LEFT">🔗 user_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD PORT="course_id" ALIGN="LEFT">🔗 course_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">课程ID</TD></TR>
        <TR><TD ALIGN="LEFT">triggered_by</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT">触发方式</TD></TR>
        <TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT">推荐原因</TD></TR>
        <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">推荐时间</TD></TR>
        </TABLE>
    >]

    rec_exercise_item [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#00695C"><FONT COLOR="white"><B> rec_exercise_item （推荐明细）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#E0F2F1"><B>字段</B></TD><TD BGCOLOR="#E0F2F1"><B>类型</B></TD><TD BGCOLOR="#E0F2F1"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD PORT="rec_id" ALIGN="LEFT">🔗 rec_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→recommendation_record</TD></TR>
        <TR><TD PORT="exercise_id" ALIGN="LEFT">🔗 exercise_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→exercise</TD></TR>
        <TR><TD ALIGN="LEFT">score</TD><TD ALIGN="LEFT">DECIMAL(10,4)</TD><TD ALIGN="LEFT">模型推荐评分</TD></TR>
        <TR><TD ALIGN="LEFT">rank_order</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT">排名序号</TD></TR>
        </TABLE>
    >]

    user_kc_state [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#F57F17"><FONT COLOR="white"><B> user_kc_state （知识点状态缓存）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#FFF9C4"><B>字段</B></TD><TD BGCOLOR="#FFF9C4"><B>类型</B></TD><TD BGCOLOR="#FFF9C4"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD PORT="user_id" ALIGN="LEFT">🔗 user_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD PORT="kp_id" ALIGN="LEFT">🔗 kp_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→knowledge_point</TD></TR>
        <TR><TD ALIGN="LEFT">mastery_level</TD><TD ALIGN="LEFT">DOUBLE</TD><TD ALIGN="LEFT">掌握度 mlkc 0~1</TD></TR>
        <TR><TD ALIGN="LEFT">correct_count</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT">答对数</TD></TR>
        <TR><TD ALIGN="LEFT">total_count</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT">总答题数</TD></TR>
        <TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">更新时间</TD></TR>
        </TABLE>
    >]

    user_exercise_forget [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#F57F17"><FONT COLOR="white"><B> user_exercise_forget （遗忘率缓存）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#FFF9C4"><B>字段</B></TD><TD BGCOLOR="#FFF9C4"><B>类型</B></TD><TD BGCOLOR="#FFF9C4"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD PORT="user_id" ALIGN="LEFT">🔗 user_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD PORT="exercise_id" ALIGN="LEFT">🔗 exercise_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→exercise</TD></TR>
        <TR><TD ALIGN="LEFT">forget_prob</TD><TD ALIGN="LEFT">DOUBLE</TD><TD ALIGN="LEFT">遗忘概率 exfr 0~1</TD></TR>
        <TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">更新时间</TD></TR>
        </TABLE>
    >]

    user_course [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#37474F"><FONT COLOR="white"><B> user_course （学生选课）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#ECEFF1"><B>字段</B></TD><TD BGCOLOR="#ECEFF1"><B>类型</B></TD><TD BGCOLOR="#ECEFF1"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD PORT="user_id" ALIGN="LEFT">🔗 user_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD PORT="course_id" ALIGN="LEFT">🔗 course_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→course</TD></TR>
        <TR><TD ALIGN="LEFT">enrolled_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">选课时间</TD></TR>
        </TABLE>
    >]

    email_verification [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#1565C0"><FONT COLOR="white"><B> email_verification （邮箱验证码）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#BBDEFB"><B>字段</B></TD><TD BGCOLOR="#BBDEFB"><B>类型</B></TD><TD BGCOLOR="#BBDEFB"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT">目标邮箱</TD></TR>
        <TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR(10)</TD><TD ALIGN="LEFT">验证码</TD></TR>
        <TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">ENUM</TD><TD ALIGN="LEFT">REGISTER/RESET_PASSWORD</TD></TR>
        <TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">过期时间(+5min)</TD></TR>
        <TR><TD ALIGN="LEFT">is_used</TD><TD ALIGN="LEFT">TINYINT</TD><TD ALIGN="LEFT">是否已使用</TD></TR>
        </TABLE>
    >]

    notification [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#AD1457"><FONT COLOR="white"><B> notification （站内通知）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#FCE4EC"><B>字段</B></TD><TD BGCOLOR="#FCE4EC"><B>类型</B></TD><TD BGCOLOR="#FCE4EC"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD PORT="user_id" ALIGN="LEFT">🔗 user_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">ENUM</TD><TD ALIGN="LEFT">GRADE_DONE/SECURITY_ALERT/SYSTEM</TD></TR>
        <TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">VARCHAR(200)</TD><TD ALIGN="LEFT">通知标题</TD></TR>
        <TR><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT">通知内容</TD></TR>
        <TR><TD ALIGN="LEFT">related_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">关联记录ID</TD></TR>
        <TR><TD ALIGN="LEFT">is_read</TD><TD ALIGN="LEFT">TINYINT</TD><TD ALIGN="LEFT">是否已读</TD></TR>
        </TABLE>
    >]

    login_record [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#4A148C"><FONT COLOR="white"><B> login_record （登录记录）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#E1BEE7"><B>字段</B></TD><TD BGCOLOR="#E1BEE7"><B>类型</B></TD><TD BGCOLOR="#E1BEE7"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD PORT="user_id" ALIGN="LEFT">🔗 user_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD ALIGN="LEFT">ip_address</TD><TD ALIGN="LEFT">VARCHAR(45)</TD><TD ALIGN="LEFT">登录IP</TD></TR>
        <TR><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT">IP解析地理位置</TD></TR>
        <TR><TD ALIGN="LEFT">user_agent</TD><TD ALIGN="LEFT">VARCHAR(500)</TD><TD ALIGN="LEFT">浏览器/设备</TD></TR>
        <TR><TD ALIGN="LEFT">is_anomaly</TD><TD ALIGN="LEFT">TINYINT</TD><TD ALIGN="LEFT">是否异常登录</TD></TR>
        </TABLE>
    >]

    mobile_upload_session [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3" BGCOLOR="#00695C"><FONT COLOR="white"><B> mobile_upload_session （跨设备上传）</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#E0F2F1"><B>字段</B></TD><TD BGCOLOR="#E0F2F1"><B>类型</B></TD><TD BGCOLOR="#E0F2F1"><B>说明</B></TD></TR>
        <TR><TD PORT="id" ALIGN="LEFT">🔑 id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">主键</TD></TR>
        <TR><TD ALIGN="LEFT">token</TD><TD ALIGN="LEFT">VARCHAR(64)</TD><TD ALIGN="LEFT">一次性Token UNIQUE</TD></TR>
        <TR><TD PORT="user_id" ALIGN="LEFT">🔗 user_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT">FK→sys_user</TD></TR>
        <TR><TD ALIGN="LEFT">file_url</TD><TD ALIGN="LEFT">VARCHAR(500)</TD><TD ALIGN="LEFT">上传后文件地址</TD></TR>
        <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD><TD ALIGN="LEFT">PENDING/DONE/EXPIRED</TD></TR>
        <TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT">过期时间(+5min)</TD></TR>
        </TABLE>
    >]

    // ─────────────────────────────────────────────────────────────
    // 关系连线（标注基数）
    // ─────────────────────────────────────────────────────────────

    // sys_user → course（教师创建课程 1:N）
    sys_user:id -> course:teacher_id         [label="1:N  创建" arrowhead=crow arrowtail=tee dir=both]

    // sys_user → classroom（教师负责班级 1:N）
    sys_user:id -> classroom:teacher_id     [label="1:N  负责" arrowhead=crow arrowtail=tee dir=both]

    // classroom ↔ course（M:N 通过 classroom_course）
    classroom:id -> classroom_course:classroom_id [label="1:N" arrowhead=crow arrowtail=tee dir=both]
    course:id     -> classroom_course:course_id   [label="1:N" arrowhead=crow arrowtail=tee dir=both]

    // classroom ↔ sys_user 学生（M:N 通过 classroom_student）
    classroom:id -> classroom_student:classroom_id [label="1:N" arrowhead=crow arrowtail=tee dir=both]
    sys_user:id  -> classroom_student:user_id     [label="1:N  加入班级" arrowhead=crow arrowtail=tee dir=both]

    // sys_user → exercise（教师创建习题 1:N）
    sys_user:id -> exercise:created_by       [label="1:N  创建" arrowhead=crow arrowtail=tee dir=both]

    // course → knowledge_point（1:N）
    course:id -> knowledge_point:course_id   [label="1:N  包含" arrowhead=crow arrowtail=tee dir=both]

    // course → exercise（1:N）
    course:id -> exercise:course_id          [label="1:N  归属" arrowhead=crow arrowtail=tee dir=both]

    // exercise ↔ knowledge_point（M:N 通过关联表）
    exercise:id -> exercise_kp_rel:exercise_id      [label="1:N" arrowhead=crow arrowtail=tee dir=both]
    knowledge_point:id -> exercise_kp_rel:kp_id     [label="1:N" arrowhead=crow arrowtail=tee dir=both]

    // sys_user → answer_record（1:N）
    sys_user:id -> answer_record:user_id     [label="1:N  答题" arrowhead=crow arrowtail=tee dir=both]

    // exercise → answer_record（1:N）
    exercise:id -> answer_record:exercise_id [label="1:N" arrowhead=crow arrowtail=tee dir=both]

    // sys_user → answer_record（批改 1:N）
    sys_user:id -> answer_record:graded_by   [label="1:N  批改" arrowhead=crow arrowtail=tee dir=both style=dashed]

    // sys_user → recommendation_record（1:N）
    sys_user:id -> recommendation_record:user_id    [label="1:N  推荐" arrowhead=crow arrowtail=tee dir=both]

    // recommendation_record → rec_exercise_item（1:N）
    recommendation_record:id -> rec_exercise_item:rec_id  [label="1:N" arrowhead=crow arrowtail=tee dir=both]

    // exercise → rec_exercise_item（1:N）
    exercise:id -> rec_exercise_item:exercise_id    [label="1:N" arrowhead=crow arrowtail=tee dir=both]

    // sys_user → user_kc_state（1:N）
    sys_user:id -> user_kc_state:user_id     [label="1:N" arrowhead=crow arrowtail=tee dir=both]

    // knowledge_point → user_kc_state（1:N）
    knowledge_point:id -> user_kc_state:kp_id [label="1:N" arrowhead=crow arrowtail=tee dir=both]

    // sys_user → user_exercise_forget（1:N）
    sys_user:id -> user_exercise_forget:user_id    [label="1:N" arrowhead=crow arrowtail=tee dir=both]

    // exercise → user_exercise_forget（1:N）
    exercise:id -> user_exercise_forget:exercise_id [label="1:N" arrowhead=crow arrowtail=tee dir=both]

    // sys_user ↔ course（M:N 选课）
    sys_user:id -> user_course:user_id   [label="1:N" arrowhead=crow arrowtail=tee dir=both]
    course:id   -> user_course:course_id [label="1:N" arrowhead=crow arrowtail=tee dir=both]

    // sys_user → notification（1:N）
    sys_user:id -> notification:user_id  [label="1:N  通知" arrowhead=crow arrowtail=tee dir=both]

    // sys_user → login_record（1:N）
    sys_user:id -> login_record:user_id  [label="1:N  登录历史" arrowhead=crow arrowtail=tee dir=both]

    // sys_user → mobile_upload_session（1:N）
    sys_user:id -> mobile_upload_session:user_id [label="1:N  上传会话" arrowhead=crow arrowtail=tee dir=both]
}
